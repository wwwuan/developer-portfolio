# Copy this file to .env and fill in local values. Never commit .env.
# Generate each signing key independently: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
SECURITY_KEY=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=
DB_NAME=testdb

# Mail
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENCODING=utf-8
REDIS_DB=0
REDIS_DECODE_RESPONSES=true

# Comma-separated administrator email addresses; empty disables registration.
ADMIN_WHITELIST=
UPLOAD_DIR=./photo

# GLM OpenAI-compatible vision API
GLM_API_KEY=
ANALYSIS_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ANALYSIS_MODEL=GLM-5.3-flash
ANALYSIS_PROMPT=请用中文描述这张图片中是什么，尽量说明主要对象、场景和可见特征。
MAX_ANALYSIS_TIME=60
